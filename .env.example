# Discord bot token — Developer Portal > Applications > your app > Bot > Reset Token.
# Never commit the real value.
BOT_TOKEN=your_discord_bot_token_here

# Your own Discord user ID. The only account admin commands respond to.
# Enable Developer Mode in Discord, then right-click your name > Copy User ID.
ADMIN_DISCORD_ID=000000000000000000

# The server slash commands are synced to (right-click the server > Copy Server ID).
GUILD_ID=000000000000000000

# Channel the daily consensus embed is posted to (right-click the channel > Copy Channel ID).
GROUP_CHANNEL_ID=000000000000000000

# SQLite file. Created automatically on first run.
DB_PATH=data/council.db

# true  = unlocks /test_* commands, bypasses the trading-day and time-window gates.
# false = production. Always false when the council is live.
TEST_MODE=false
